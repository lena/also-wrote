TMDB_API_TOKEN=your_token_here
PORT=8080

# Homebrew Postgres uses your Mac username as the default role (no password for local)
DATABASE_URL=postgres://YOUR_USERNAME@localhost:5432/also_wrote?sslmode=disable

# Auth: required for login/sessions (use a long random string in production)
SESSION_SECRET=1234567890

# Magic link base URL (for email links; default http://localhost:8080)
APP_URL=http://localhost:8080

# Email (optional: if not set, magic links are logged to the server console)
# MAILER_FROM=noreply@yourdomain.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
